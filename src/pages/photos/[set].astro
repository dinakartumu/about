---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import { photoUrl } from '../../lib/images';
import { layOutSections } from '../../lib/photo-layout';
import WalkMap from '../../components/WalkMap.astro';
import PhotoViewer from '../../components/lightbox/PhotoViewer';

export async function getStaticPaths() {
  const sets = await getCollection('photosets');
  return sets.map((set) => ({ params: { set: set.data.slug }, props: { set } }));
}

const { set } = Astro.props;
const { title, description, photos, cover, sections } = set.data;
const ogImage = photoUrl(cover, { width: 1200, height: 630, fit: 'cover', format: 'jpeg' });

// Split into headed runs (one untitled run when the set declares no sections),
// pairing adjacent portraits within each. Photo indices stay global so they
// keep addressing the flat lightbox list below.
const laidOut = layOutSections(photos, sections);

// The walks behind the set, generated by scripts/build-walk-maps.mjs. Only
// sets with enough walking have one; the rest simply have no file.
const walkMaps = import.meta.glob<{ default: WalkMapData }>('../../data/walk-maps/*.json', {
  eager: true,
});
type WalkMapData = Parameters<typeof WalkMap>[0]['map'];
const walkMap =
  walkMaps[`../../data/walk-maps/${set.data.slug}.json`]?.default ?? null;
const lightboxItems = photos.map((p) => ({
  url: photoUrl(p.id, { width: 2400, fit: 'scale-down' }),
  id: p.id,
  w: p.width,
  h: p.height,
}));
---
<Layout title={`${title} · Photos · Dinakar Tumu`} description={description || `${title} photoset.`} image={ogImage}>
  <article class="container">
    <header>
      <h1>{title}</h1>
      {description && <p class="muted">{description}</p>}
      <p class="muted count">{photos.length} photos</p>
    </header>

    {laidOut.map((section) => (
      <section class="movement">
        {section.title && <h2 id={section.id}>{section.title}</h2>}
        <div class="photos">
          {section.rows.map((row) => (
            <div class={`row ${row.photos.length === 2 ? 'pair' : ''}`}>
              {row.photos.map(({ photo, index }) => (
                <Photo
                  photo={photo}
                  index={index}
                  sizes={row.photos.length === 2 ? '(max-width: 40rem) 100vw, (max-width: 76rem) 50vw, 36rem' : undefined}
                />
              ))}
            </div>
          ))}
        </div>
      </section>
    ))}

    {walkMap && <WalkMap map={walkMap} />}
  </article>

  <PhotoViewer client:load items={lightboxItems} />
</Layout>

<style>
  header { max-width: 44rem; margin: 0 auto 2rem; text-align: center; }
  header h1 { margin: 0 0 0.25rem; }
  .count { font-size: 0.85rem; }

  /* Sets without sections render as a single .movement with no heading, so
     the sibling selector leaves their spacing exactly as it was. */
  .movement + .movement { margin-top: 4.5rem; }
  /* Weight, line-height and colour come from the global h1/h2/h3 rule. */
  .movement h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    letter-spacing: -0.01em;
    scroll-margin-top: 1.5rem;
  }

  .photos { display: flex; flex-direction: column; gap: 2.5rem; }
  .row.pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  @media (max-width: 40rem) {
    .row.pair { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
