---
import { photoUrl, photoSrcset } from '../lib/images';
import Exif from './Exif.astro';
import PhotoTrigger from './lightbox/PhotoTrigger';

interface Props {
  photo: {
    id: string;
    width: number;
    height: number;
    exif?: Record<string, any>;
  };
  index: number;
  sizes?: string;
}
const { photo, index, sizes = '(max-width: 76rem) 100vw, 72rem' } = Astro.props;
const srcset = photoSrcset(photo.id);
---
<figure>
  <PhotoTrigger
    client:visible
    index={index}
    href={photoUrl(photo.id, { width: 2400, fit: 'scale-down' })}
    src={photoUrl(photo.id, { width: 1200, fit: 'scale-down' })}
    srcset={srcset || undefined}
    sizes={sizes}
    width={photo.width}
    height={photo.height}
  />
  <Exif exif={photo.exif} />
</figure>

<style>
  figure { margin: 0; }
  figure :global(.photo-link) { display: block; }
  figure :global(img) { display: block; width: 100%; height: auto; border-radius: 4px; background: var(--surface); }
</style>
