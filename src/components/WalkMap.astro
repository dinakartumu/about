---
/**
 * The activity behind a photoset, over a Mapbox basemap.
 *
 * The basemap is a CSS background rather than an <image> in the SVG, so the
 * light and dark variants can be swapped by selector and the visitor only ever
 * downloads the one they can see. The routes sit on top as an SVG whose
 * viewBox matches the basemap's pixel space exactly — they were projected into
 * it by scripts/build-walk-maps.mjs, Web Mercator about the same centre and
 * zoom Mapbox rendered at, which is what puts them on the street centrelines.
 *
 * Most sets were photographed on foot and say so. Goa was ridden, so foot and
 * wheel are drawn in different colours and the wording follows — "97 mi
 * covered" rather than a claim about walking.
 *
 * Nothing is computed here and nothing runs in the browser: the geometry is
 * committed, the PNGs live in R2 beside the photos and go through the same
 * Cloudflare transform. No Mapbox token ships.
 */
import { assetUrl } from '../lib/images';

interface Props {
  map: {
    /** Display name; may differ from Strava's labels. */
    title: string;
    place: string;
    images: { dark: string; light: string };
    width: number;
    height: number;
    paths: { d: string; foot: boolean }[];
    breakdown: { sport: string; count: number; miles: number }[];
    footOnly: boolean;
    walkOnly: boolean;
    activities: number;
    miles: number;
    months: number;
    attribution: string;
  };
}
const { map } = Astro.props;

// The rendered PNG is 2x the logical box, so ask for that many pixels.
const basemap = (key: string) =>
  `url("${assetUrl(key, { width: map.width * 2, fit: 'scale-down' })}")`;

/** "TrailRun" → "trail runs", so the stats line reads as prose. */
const spaced = (sport: string) => sport.replace(/([a-z])([A-Z])/g, '$1 $2').toLowerCase();
const sportLabel = (sport: string, count: number) =>
  count === 1 ? spaced(sport) : `${spaced(sport)}s`;

const FOOT = new Set(['walk', 'hike', 'run', 'trail run', 'virtual run']);
const isFoot = (sport: string) => FOOT.has(spaced(sport));

// Say what was actually done: "walked" only when it all was, "on foot" when
// it was hiked or run too, "covered" once wheels are involved.
const distanceVerb = map.walkOnly ? 'walked' : map.footOnly ? 'on foot' : 'covered';

// Draw wheels first so the rarer foot routes read on top of them.
const ordered = [...map.paths].sort((a, b) => Number(a.foot) - Number(b.foot));
---
<section class="walkmap" aria-labelledby="walkmap-heading">
  <h2 id="walkmap-heading">{map.footOnly ? 'On foot in' : 'Around'} {map.title}</h2>

  <div
    class="frame"
    style={`--map-dark: ${basemap(map.images.dark)}; --map-light: ${basemap(map.images.light)}; aspect-ratio: ${map.width} / ${map.height};`}
  >
    <svg
      viewBox={`0 0 ${map.width} ${map.height}`}
      role="img"
      aria-label={`Map of ${map.activities} activities totalling ${map.miles} miles in ${map.title}`}
    >
      {ordered.map((p) => <path class={p.foot ? 'foot' : 'wheel'} d={p.d} />)}
    </svg>
  </div>

  <p class="stats">
    {map.breakdown.map((t) => (
      <span class={isFoot(t.sport) ? 'foot' : 'wheel'}>
        <i class="dot" aria-hidden="true"></i><b>{t.count}</b> {sportLabel(t.sport, t.count)}
      </span>
    ))}
    <span><b>{map.miles}</b> mi {distanceVerb}</span>
    <span><b>{map.months}</b> {map.months === 1 ? 'month' : 'months'}</span>
  </p>
  <p class="attr">{map.attribution}</p>
</section>

<style>
  .walkmap { margin-top: 4.5rem; --route-wheel: #6f9dc4; }
  :global(:root[data-theme='light']) .walkmap { --route-wheel: #2f6690; }

  .walkmap h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    letter-spacing: -0.01em;
  }

  /* Dark is the default, matching global.css; the inline theme script sets
     data-theme before first paint, so there is no flash of the wrong basemap. */
  .frame {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background-color: var(--surface);
    background-image: var(--map-dark);
    background-size: cover;
    background-position: center;
  }
  :global(:root[data-theme='light']) .frame { background-image: var(--map-light); }

  svg { position: absolute; inset: 0; width: 100%; height: 100%; }

  /* One weight per mode: the basemap is already doing the talking, and
     overlapping traces brighten whatever was covered most. */
  path {
    fill: none;
    stroke-opacity: 0.85;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  path.foot { stroke: var(--accent); }
  path.wheel { stroke: var(--route-wheel); stroke-opacity: 0.72; }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 1rem;
    margin: 0.75rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .stats b { color: var(--text); font-weight: 600; }
  .dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    margin-right: 0.4rem;
  }
  .stats .foot .dot { background: var(--accent); }
  .stats .wheel .dot { background: var(--route-wheel); }
  .attr { margin: 0.4rem 0 0; font-size: 0.7rem; color: var(--muted); opacity: 0.7; }
</style>
